<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>IRCCLIENT</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Packaging -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>MarioFinale</Authors>
    <Company>MarioFinale</Company>
    <Description>IRC client library for .NET.</Description>
    <Copyright>MarioFinale</Copyright>
    <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MarioFinale/IRCCLIENT</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/MarioFinale/IRCCLIENT</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>See https://github.com/MarioFinale/IRCCLIENT/commits/master/ for changes</PackageReleaseNotes>
    <PackageTags>irc; irc client; dotnet; vbnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="IRCMessages.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>IRCMessages.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="IRCMessages.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <LastGenOutput>IRCMessages.Designer.vb</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MWBot.net" Version="1.3.*" />
    <None Include="..\README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>